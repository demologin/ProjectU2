<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Properties>
        <Property name="PATTERN"
                  value="%d{HH:mm:ss} %highlight{%-5level} %style{%C{1}}{bright,yellow}.%M: %msg%n%throwable"/>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${PATTERN}" disableAnsi="false"/>
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="com.javarush.zimina" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>